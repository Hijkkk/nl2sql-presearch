# LLM
LLM_PROVIDER=litellm_internal
ANTHROPIC_BASE_URL=http://your-litellm-host:4000
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=Qwen3-Coder-Next-FP8
LLM_TIMEOUT=60
SQL_GENERATION_CACHE_SECONDS=600
NL2SQL_DEBUG_OUTPUT=true

# DashScope 备用模型（不要把 Key 提交到仓库）
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-max


# XiYanSQL 3B via Ollama (quantized GGUF, offline demo)
XIYAN_OLLAMA_ENABLED=true
XIYAN_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
XIYAN_OLLAMA_API_KEY=ollama
XIYAN_OLLAMA_MODEL=xiyansql-3b

# XiYanSQL 3B finetune/Transformers service
XIYAN_FINETUNE_ENABLED=true
XIYAN_FINETUNE_BASE_URL=http://127.0.0.1:8010/v1
XIYAN_FINETUNE_API_KEY=
XIYAN_FINETUNE_MODEL=XiYanSQL-QwenCoder-3B-2504
XIYAN_FINETUNE_MODEL_PATH=Z:\python\Projects\task\datasources\XiYanSQL-QwenCoder-3b\XiYanSQL-QwenCoder-3B-2504

# User system database
USER_DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/nl2sql?charset=utf8mb4

# Business MySQL query data source
MYSQL_QUERY_ENABLED=true
MYSQL_QUERY_NAME=mysql_police_address
MYSQL_QUERY_HOST=127.0.0.1
MYSQL_QUERY_PORT=3306
MYSQL_QUERY_USER=root
MYSQL_QUERY_PASSWORD=
MYSQL_QUERY_DATABASE=police_address
MYSQL_QUERY_CHARSET=utf8mb4
MYSQL_QUERY_DESCRIPTION=本地 MySQL 警务地址库（police_address，一标三实、地址别名、实有人口、警情数据）

# Metadata summary cache
METADATA_SUMMARY_ENABLED=true
METADATA_SUMMARY_USE_LLM_IN_CHAT=false
METADATA_SUMMARY_CACHE_PATH=./data/metadata_summaries.json
POSTGRES_METADATA_CACHE_TTL_SECONDS=60

# Controlled Agent: keep disabled until routing, audit and regression evaluation pass.
AGENT_ENABLED=false
AGENT_RECORD_ONLY=true
AGENT_SOURCE_CANDIDATE_LIMIT=3
AGENT_SCHEMA_OBJECT_LIMIT=3
AGENT_MAX_PLAN_REVISIONS=1
AGENT_PLANNER_DASHSCOPE_ENABLED=true
AGENT_PLANNER_MODEL=qwen3.7-max
AGENT_PLANNER_MAX_TOKENS=800
AGENT_SQL_MODEL_ID=xiyan-sql-3b-finetune
AGENT_EXECUTE_TIMEOUT=30
AGENT_XIYAN_CONTEXT_WINDOW=8192
AGENT_XIYAN_PROMPT_TOKEN_BUDGET=6200
AGENT_XIYAN_MAX_OUTPUT_TOKENS=256
AGENT_XIYAN_SAFETY_MARGIN_TOKENS=800
AGENT_VECTOR_ENABLED=false
AGENT_QDRANT_URL=http://127.0.0.1:6333
AGENT_QDRANT_COLLECTION=nl2sql_metadata_v1
AGENT_EMBEDDING_MODEL=qwen3.7-text-embedding
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_EMBEDDING_TIMEOUT=15

# Optional independent reviewer. Keep the key only in .env, never commit it.

# Audit
AUDIT_DB_PATH=data/audit.db
AUDIT_RESULT_SAMPLE_ROWS=50

# REST API query data source
REST_API_ENABLED=false
REST_API_NAME=rest_api_demo
REST_API_URL=https://api.jsonplaceholder.dev/posts
REST_API_TABLE_NAME=posts
REST_API_DATA_PATH=
REST_API_HEADERS_JSON={}
REST_API_QUERY_PARAMS_JSON={}
REST_API_KEY_PARAM=
REST_API_API_KEY=
REST_API_DESCRIPTION=REST API JSON 数据源
REST_API_TIMEOUT=10
REST_API_CACHE_TTL_SECONDS=60
REST_API_SERVICE_MODE=table

# PostgreSQL query data source
POSTGRES_QUERY_ENABLED=false
POSTGRES_QUERY_NAME=postgres_local
POSTGRES_QUERY_HOST=127.0.0.1
POSTGRES_QUERY_PORT=5432
POSTGRES_QUERY_USER=postgres
POSTGRES_QUERY_PASSWORD=
POSTGRES_QUERY_DATABASE=
POSTGRES_QUERY_SCHEMA=public
POSTGRES_QUERY_DESCRIPTION=PostgreSQL 业务数据库

# GaussDB query data source, PostgreSQL-compatible mode
GAUSS_QUERY_ENABLED=false
GAUSS_QUERY_NAME=gauss_local
GAUSS_QUERY_HOST=127.0.0.1
GAUSS_QUERY_PORT=5432
GAUSS_QUERY_USER=
GAUSS_QUERY_PASSWORD=
GAUSS_QUERY_DATABASE=
GAUSS_QUERY_SCHEMA=public
GAUSS_QUERY_DESCRIPTION=高斯数据库业务数据源

# Hive / Hadoop query data source
HIVE_QUERY_ENABLED=false
HIVE_QUERY_NAME=hive_local
HIVE_QUERY_HOST=127.0.0.1
HIVE_QUERY_PORT=10000
HIVE_QUERY_USER=
HIVE_QUERY_PASSWORD=
HIVE_QUERY_DATABASE=default
HIVE_QUERY_AUTH=NOSASL
HIVE_QUERY_DESCRIPTION=Hive/Hadoop 数仓数据源
# server: 连接真实 HiveServer2；local_demo: 使用 ./data/hadoop_order_events.csv 做无 Hive 环境演示
HIVE_QUERY_MODE=server
HIVE_DEMO_CSV_PATH=./data/hadoop_order_events.csv

# Dameng query data source
DAMENG_QUERY_ENABLED=false
DAMENG_QUERY_NAME=dameng_local
DAMENG_QUERY_HOST=127.0.0.1
DAMENG_QUERY_PORT=5236
DAMENG_QUERY_USER=
DAMENG_QUERY_PASSWORD=
DAMENG_QUERY_SCHEMA=
DAMENG_JVM_PATH=
DAMENG_QUERY_DESCRIPTION=达梦数据库业务数据源

# Cloud PostgreSQL providers such as Aiven usually require SSL.
# Example: POSTGRES_QUERY_SSLMODE=require


