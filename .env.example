# LLM
LLM_PROVIDER=litellm_internal
ANTHROPIC_BASE_URL=http://your-litellm-host:4000
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=Qwen3-Coder-Next-FP8

# User system database
USER_DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/nl2sql?charset=utf8mb4

# Business MySQL query data source
MYSQL_QUERY_ENABLED=true
MYSQL_QUERY_NAME=mysql_local
MYSQL_QUERY_HOST=127.0.0.1
MYSQL_QUERY_PORT=3306
MYSQL_QUERY_USER=root
MYSQL_QUERY_PASSWORD=
MYSQL_QUERY_DATABASE=
MYSQL_QUERY_CHARSET=utf8mb4
MYSQL_QUERY_DESCRIPTION=本地 MySQL 业务数据库

# Metadata summary cache
METADATA_SUMMARY_ENABLED=true
METADATA_SUMMARY_USE_LLM_IN_CHAT=false
METADATA_SUMMARY_CACHE_PATH=./data/metadata_summaries.json

# REST API query data source
REST_API_ENABLED=false
REST_API_NAME=rest_api_demo
REST_API_URL=https://api.jsonplaceholder.dev/posts
REST_API_TABLE_NAME=posts
REST_API_DATA_PATH=
REST_API_HEADERS_JSON={}
REST_API_QUERY_PARAMS_JSON={}
REST_API_KEY_PARAM=
REST_API_API_KEY=
REST_API_DESCRIPTION=REST API JSON 数据源
REST_API_TIMEOUT=10
REST_API_CACHE_TTL_SECONDS=60
REST_API_SERVICE_MODE=table

# PostgreSQL query data source
POSTGRES_QUERY_ENABLED=false
POSTGRES_QUERY_NAME=postgres_local
POSTGRES_QUERY_HOST=127.0.0.1
POSTGRES_QUERY_PORT=5432
POSTGRES_QUERY_USER=postgres
POSTGRES_QUERY_PASSWORD=
POSTGRES_QUERY_DATABASE=
POSTGRES_QUERY_SCHEMA=public
POSTGRES_QUERY_DESCRIPTION=PostgreSQL 业务数据库

# GaussDB query data source, PostgreSQL-compatible mode
GAUSS_QUERY_ENABLED=false
GAUSS_QUERY_NAME=gauss_local
GAUSS_QUERY_HOST=127.0.0.1
GAUSS_QUERY_PORT=5432
GAUSS_QUERY_USER=
GAUSS_QUERY_PASSWORD=
GAUSS_QUERY_DATABASE=
GAUSS_QUERY_SCHEMA=public
GAUSS_QUERY_DESCRIPTION=高斯数据库业务数据源

# Hive / Hadoop query data source
HIVE_QUERY_ENABLED=false
HIVE_QUERY_NAME=hive_local
HIVE_QUERY_HOST=127.0.0.1
HIVE_QUERY_PORT=10000
HIVE_QUERY_USER=
HIVE_QUERY_PASSWORD=
HIVE_QUERY_DATABASE=default
HIVE_QUERY_AUTH=NOSASL
HIVE_QUERY_DESCRIPTION=Hive/Hadoop 数仓数据源

# Dameng query data source
DAMENG_QUERY_ENABLED=false
DAMENG_QUERY_NAME=dameng_local
DAMENG_QUERY_HOST=127.0.0.1
DAMENG_QUERY_PORT=5236
DAMENG_QUERY_USER=
DAMENG_QUERY_PASSWORD=
DAMENG_QUERY_SCHEMA=
DAMENG_QUERY_DESCRIPTION=达梦数据库业务数据源

# Cloud PostgreSQL providers such as Aiven usually require SSL.
# Example: POSTGRES_QUERY_SSLMODE=require
